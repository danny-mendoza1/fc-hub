<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit and contract tests for the plugin's pure logic (no game needed); see the root README for the command.
    They run on Microsoft Testing Platform (MTP), not VSTest: the repo-root global.json opts `dotnet test` into
    MTP mode, which xUnit v3 4.x needs on the .NET 10 SDK. So there's no Microsoft.NET.Test.Sdk or
    xunit.runner.visualstudio here; Visual Studio and Rider run MTP tests directly.
    Building it needs the Dalamud reference assemblies, like the plugin itself. Tests must not touch
    types that need the game at runtime (Dalamud, FFXIVClientStructs): those assemblies aren't copied here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact versions (with packages.lock.json); Dependabot bumps them. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FcHub/FcHub.csproj" />
    <!-- The same fixtures the web tests use (web/test/plugin-contract.test.ts). -->
    <None Include="../../web/test/fixtures/plugin-*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
