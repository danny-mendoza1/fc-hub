{
  "name": "fc-hub-web",
  "private": true,
  "type": "module",
  "description": "FC Hub web API: stores inventory snapshots from the FC Hub plugin and serves item search.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "build": "vite build",
    "start": "node src/node.ts",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fc-hub --local",
    "db:preflight:remote": "wrangler d1 execute fc-hub --remote --file scripts/preflight-diff-ingest.sql",
    "db:migrate:remote": "wrangler d1 migrations apply fc-hub --remote"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.0.0"
  }
}
